{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022", // or `ESNext`
    "target": "ESNext",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    //"module": "commonjs",
    "allowSyntheticDefaultImports": true,
    "types": ["jest", "node", "@testing-library/jest-dom"],
    "isolatedModules": true,
    "paths": {
      "test-utils": ["./test/__utils__/test-utils"]
    }
  },
  "include": [
    "src/**/*", // ВАЖНО: берем абсолютно ВСЕ файлы из src, чтобы data.ts компилировался
    "jest.setup.ts",
    "test/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
